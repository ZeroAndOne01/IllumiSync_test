<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Light Control"
                android:textColor="#181C1F"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Adjust brightness and create the right atmosphere."
                android:textColor="#757575"
                android:textSize="14sp"/>

            <!-- MASTER LIGHT CONTROL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Master Light Control"
                        android:textColor="#181C1F"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Turn the lighting system on or off."
                        android:textColor="#757575"
                        android:textSize="13sp"/>

                </LinearLayout>

                <Switch
                    android:id="@+id/masterLightSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Master light control"/>

            </LinearLayout>

            <!-- BRIGHTNESS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Brightness"
                    android:textColor="#181C1F"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/lightBrightnessText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end"
                    android:text="Brightness: 50%"
                    android:textColor="#181C1F"
                    android:textSize="15sp"/>

                <SeekBar
                    android:id="@+id/lightSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"/>

            </LinearLayout>

            <!-- SCENE PRESETS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Scene Presets"
                android:textColor="#181C1F"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Choose a lighting setup for your activity."
                android:textColor="#757575"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/focusButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="Focus"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#181C1F"/>

            <Button
                android:id="@+id/relaxButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Relax"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#181C1F"/>

            <Button
                android:id="@+id/movieButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Movie"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#181C1F"/>

            <Button
                android:id="@+id/sleepButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Sleep"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#181C1F"/>

            <!-- AMBIENT LIGHT SCHEDULE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ambient Light Schedule"
                    android:textColor="#181C1F"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Set a target illuminance level."
                    android:textColor="#757575"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/ambientScheduleButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Set Target Lux"
                    android:textAllCaps="false"
                    android:backgroundTint="#181C1F"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

            <!-- GRADUAL DIMMING -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gradual Dimming"
                    android:textColor="#181C1F"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Control how quickly brightness changes."
                    android:textColor="#757575"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/gradualDimmingButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Set Transition Duration"
                    android:textAllCaps="false"
                    android:backgroundTint="#181C1F"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/bottom_navigation"/>

</LinearLayout>
